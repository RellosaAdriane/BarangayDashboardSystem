PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=barangay_dashboard
DB_USER=root
DB_PASSWORD=
SESSION_SECRET=replace-with-a-long-random-value

# Optional face recognition integration
ESP32_CAPTURE_URL=http://your-camera-address/capture
COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=your-recognition-service-api-key
COMPREFACE_DET_PROB_THRESHOLD=0.5
COMPREFACE_RECOGNITION_THRESHOLD=0.8

# Camera clip recording (requires FFmpeg installed on the Node.js server)
FFMPEG_PATH=ffmpeg
RECORDINGS_DIR=./storage/recordings
RECORDING_SEGMENT_SECONDS=300