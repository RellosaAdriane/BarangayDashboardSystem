SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
RECORDINGS_DIR=./storage/recordings
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
DB_POOL_MAX=5
DATABASE_SSL=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
CAMERA_RELAY_BASE_URL=https://stream.example.com
CAMERA_RELAY_SECRET=replace-with-the-same-random-secret-at-least-32-bytes
RELAY_DOMAIN=stream.example.com

# Private Cloudflare R2 bucket for ESP32 microSD recordings. Server only.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=barangaywatch-recordings
