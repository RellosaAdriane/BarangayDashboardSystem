SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
FFMPEG_PATH=ffmpeg
RECORDINGS_DIR=./storage/recordings
RECORDING_SEGMENT_SECONDS=300
ENABLE_CAMERA_RECORDING=false
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
DB_POOL_MAX=5
DATABASE_SSL=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
CAMERA_RELAY_BASE_URL=https://stream.example.com
CAMERA_RELAY_SECRET=replace-with-the-same-random-secret-at-least-32-bytes
RELAY_DOMAIN=stream.example.com
